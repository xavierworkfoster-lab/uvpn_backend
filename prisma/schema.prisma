generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PaymentStatus {
  WAITING
  CONFIRMING
  FINISHED
  FAILED
  EXPIRED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum VpnServerStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum VpnSessionStatus {
  ACTIVE
  CLOSED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String

  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)

  emailVerified Boolean        @default(false)

  payments      Payment[]
  subscriptions Subscription[]
  devices       Device[]
  vpnSessions   VpnSession[]
  refreshTokens RefreshToken[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  description   String?

  priceUsd      Decimal        @db.Decimal(10, 2)
  durationDays  Int
  maxDevices    Int            @default(1)

  isActive      Boolean        @default(true)

  payments      Payment[]
  subscriptions Subscription[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isActive])
}

model Payment {
  id                 String        @id @default(uuid())

  userId             String
  planId             String

  provider           String
  providerPaymentId  String?       @unique
  providerInvoiceId  String?       @unique

  orderId            String        @unique

  priceAmount        Decimal       @db.Decimal(10, 2)
  priceCurrency      String

  payCurrency        String?
  payAmount          Decimal?      @db.Decimal(30, 12)

  status             PaymentStatus @default(WAITING)

  user               User          @relation(fields: [userId], references: [id])
  plan               Plan          @relation(fields: [planId], references: [id])

  events             PaymentEvent[]

  paidAt             DateTime?
  processedAt        DateTime?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model PaymentEvent {
  id          String   @id @default(uuid())

  paymentId   String
  eventType   String
  eventKey    String?  @unique
  payload     Json

  payment     Payment  @relation(fields: [paymentId], references: [id])

  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model Subscription {
  id          String             @id @default(uuid())

  userId      String
  planId      String

  status      SubscriptionStatus @default(ACTIVE)

  startedAt   DateTime
  expiresAt   DateTime

  user        User               @relation(fields: [userId], references: [id])
  plan        Plan               @relation(fields: [planId], references: [id])

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status, expiresAt])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  familyId    String   @default(uuid())
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model Device {
  id          String       @id @default(uuid())

  userId      String

  deviceId    String
  deviceName  String

  status      DeviceStatus @default(ACTIVE)

  lastSeenAt  DateTime?

  user        User         @relation(fields: [userId], references: [id])

  sessions    VpnSession[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  revokedAt   DateTime?

  @@unique([userId, deviceId])
  @@index([userId])
}

model VpnServer {
  id           String          @id @default(uuid())

  name         String

  country      String
  city         String

  hostname     String
  ipAddress    String?

  protocol     String
  port         Int

  status       VpnServerStatus @default(ONLINE)

  maxUsers     Int             @default(100)
  currentUsers Int             @default(0)

  sessions     VpnSession[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([country])
  @@index([status])
}

model VpnSession {
  id         String           @id @default(uuid())

  userId     String
  deviceId   String
  serverId   String

  status     VpnSessionStatus @default(ACTIVE)

  startedAt  DateTime         @default(now())
  expiresAt  DateTime?

  lastSeenAt DateTime?

  user       User             @relation(fields: [userId], references: [id])
  device     Device           @relation(fields: [deviceId], references: [id])
  server     VpnServer        @relation(fields: [serverId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([serverId])
  @@index([status])
}
